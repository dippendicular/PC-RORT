# Copy to .env for a locally configured PC-RORT portal.
# Use private services and rotate secrets; never commit populated .env.
DATABASE_URL=postgresql+psycopg://pcrort:change-me@127.0.0.1:5432/pcrort
REDIS_URL=redis://127.0.0.1:6379/0
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET=pcrort-private
JWT_SECRET=replace-with-random-secret-at-least-32-chars
CSRF_SECRET=replace-with-different-random-secret-at-least-32-chars
SECURE_COOKIES=false
